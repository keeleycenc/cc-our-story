@page "/admin"
@model OurStory.Web.Areas.Admin.Pages.IndexModel
@{
    ViewData["ActiveMenu"] = "dashboard";
    ViewData["Eyebrow"] = "DASHBOARD";
    ViewData["Title"] = "总览";
}
<div class="stat-grid">
    <div class="stat-card">
        <span>@Icon("heart")相恋</span>
        <strong>@(Model.LoveDays > 0 ? $"第 {Model.LoveDays} 天" : "还没设置")</strong>
    </div>
    <div class="stat-card">
        <span>@Icon("camera")点点滴滴</span>
        <strong>@Model.PublishedCount<span style="font-size:12px;color:var(--faint)"> / @Model.TotalCount</span></strong>
    </div>
    <div class="stat-card">
        <span>@Icon("calendar-heart")纪念日</span>
        <strong>@Model.AnniversaryCount</strong>
    </div>
    <div class="stat-card">
        <span>@Icon("message-circle-heart")留言</span>
        <strong>@Model.CommentCount</strong>
    </div>
    <div class="stat-card">
        <span>@Icon("sparkles")心动</span>
        <strong>@(Model.Heartbeat.Totals.GetValueOrDefault("boy") + Model.Heartbeat.Totals.GetValueOrDefault("girl"))</strong>
    </div>
</div>

<div class="admin-panel">
    <h2>@Icon("heart")彼此心动的瞬间</h2>
    <div class="stat-grid" style="margin-bottom:0">
        <div class="stat-card">
            <span>@Icon("user-round")@Model.Site.BoyName</span>
            <strong>@Model.Heartbeat.Totals.GetValueOrDefault("boy")</strong>
        </div>
        <div class="stat-card">
            <span>@Icon("user-round")@Model.Site.GirlName</span>
            <strong>@Model.Heartbeat.Totals.GetValueOrDefault("girl")</strong>
        </div>
        <div class="stat-card">
            <span>@Icon("sparkles")路过的祝福</span>
            <strong>@Model.Heartbeat.Totals.GetValueOrDefault("guest")</strong>
        </div>
    </div>
</div>

@* 余额是流水加出来的，不是某一列上的数字。一行两格，左右各看各的 *@
<div class="admin-panel">
    <div class="admin-toolbar">
        <h2 style="margin:0">@Icon("coins") 彼此的心意</h2>
        <a class="btn btn-small" href="/admin/shop">@Icon("store")心意商城</a>
    </div>
    <div class="heart-balance-grid">
        @foreach (var balance in Model.Balances)
        {
            <div class="stat-card">
                <span>@Icon("coins")@balance.Name 的心意</span>
                <strong>@balance.Balance</strong>
                <small>累计获得 @balance.Earned · 已兑换 @balance.Spent</small>
            </div>
        }
    </div>
</div>

<div class="admin-panel">
    <div class="admin-toolbar">
        <h2 style="margin:0">@Icon("camera") 最近记录</h2>
        <a class="btn btn-small" href="/admin/moments/edit">@Icon("plus")写一条</a>
    </div>

    @if (Model.Recent.Count > 0)
    {
        <div class="admin-moment-list">
            @foreach (var moment in Model.Recent)
            {
                <article class="admin-moment-item">
                    <div class="admin-moment-summary">
                        <div class="admin-moment-title">
                            <a href="/admin/moments/edit/@moment.Id">@moment.Title</a>
                        </div>
                        <div class="admin-moment-meta">
                            <span>@Icon("calendar-days")@Model.ToLocal(moment.MomentDate).ToString("yyyy-MM-dd")</span>
                            @if (moment.Status == MomentStatus.Draft)
                            {
                                <span class="tag is-draft">草稿</span>
                            }
                            else
                            {
                                <span class="tag">已发布</span>
                            }
                            @if (moment.IsProtected)
                            {
                                <span class="tag is-locked">@Icon("lock")上锁</span>
                            }
                        </div>
                    </div>
                    <div class="admin-moment-actions" aria-label="@moment.Title 的操作">
                        <a class="btn btn-ghost btn-small" href="/moments/@moment.Slug" target="_blank" rel="noopener" title="查看文章">@Icon("eye")<span>看看</span></a>
                        <a class="btn btn-ghost btn-small" href="/admin/moments/edit/@moment.Id" title="编辑文章">@Icon("pen-line")<span>编辑</span></a>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <p class="admin-empty">你还没有写过记录，从第一条开始吧。</p>
    }
</div>

@* 纪念日按「下一次在什么时候」排好，总览只提醒还会再来的那几个，
   过去的一次性日子留在纪念日页面里回看就好 *@
<div class="admin-panel">
    <div class="admin-toolbar">
        <h2 style="margin:0">@Icon("calendar-heart") 接下来的日子</h2>
        <a class="btn btn-small" href="/admin/anniversaries/edit">@Icon("plus")添加</a>
    </div>

    @if (Model.Upcoming.Count > 0)
    {
        <div class="admin-day-list">
            @foreach (var item in Model.Upcoming)
            {
                <a class="admin-day-item @(item.IsToday ? "is-today" : null)" href="/admin/anniversaries/edit/@item.Id">
                    <span class="admin-day-mark">@Icon(AnniversaryKinds.Icon(item.Kind))</span>
                    <span class="admin-day-summary">
                        <span class="admin-day-title">
                            <span>@item.Title</span>
                            @if (item.IsPrivate)
                            {
                                <span class="tag is-draft">@Icon("lock")私密</span>
                            }
                        </span>
                        <span class="admin-day-meta">
                            <span>@Icon("calendar-days")@item.NextDate!.Value.ToString("yyyy-MM-dd")</span>
                            <span>@AnniversaryKinds.Name(item.Kind)</span>
                            @if (item.RepeatYearly && item.Years > 0)
                            {
                                <span>第 @item.Years 年</span>
                            }
                        </span>
                    </span>
                    <span class="admin-day-count">@(item.IsToday ? "就在今天" : $"还有 {item.DaysUntil} 天")</span>
                </a>
            }
        </div>

        @if (Model.AnniversaryCount > Model.Upcoming.Count)
        {
            <a class="admin-day-more" href="/admin/anniversaries">@Icon("arrow-right")看看全部 @Model.AnniversaryCount 个纪念日</a>
        }
    }
    else
    {
        <p class="admin-empty">还没有记下要等的日子，去添加一个吧。</p>
    }
</div>

<blockquote class="admin-vow">
    @Icon("quote")
    <p>既然选择了彼此，就请记得，未来不只有鲜花、浪漫和快乐。你将与TA一起经历父母老去与离世的悲伤、面对生活突如其来的危机，一起熬过疾病、低谷和挫折，也一起承担岁月赋予人生的种种考验。</p>
    <footer>愿我们始终善良，彼此疼爱，相互理解</footer>
</blockquote>
