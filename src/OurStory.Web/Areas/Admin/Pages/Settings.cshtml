@page "/admin/settings"
@model OurStory.Web.Areas.Admin.Pages.SettingsModel
@{
    ViewData["ActiveMenu"] = "settings";
    ViewData["Eyebrow"] = "SETTINGS";
    ViewData["Title"] = "站点设置";

    var colorModes = new[]
    {
        new SelectListItem("跟随系统", "auto"),
        new SelectListItem("始终浅色", "light"),
        new SelectListItem("始终深色", "dark")
    };

    var storageDrivers = new[]
    {
        new SelectListItem("自动（OSS 配置完整时使用 OSS）", ""),
        new SelectListItem("本地目录", "Local"),
        new SelectListItem("阿里云 OSS", "AliyunOss")
    };

    var emailSecurityOptions = new[]
    {
        new SelectListItem("STARTTLS（常用端口 587）", "StartTls"),
        new SelectListItem("SSL/TLS（常用端口 465）", "SslTls"),
        new SelectListItem("不加密", "None")
    };
}
<form method="post" data-dirty-guard>
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <p class="admin-error">@Icon("circle-alert")@Model.Error</p>
    }

    <div class="admin-panel">
        <h2>@Icon("house")站点</h2>
        <div class="field-grid">
            <label class="field">
                <span>站点名称</span>
                <input asp-for="Input.SiteTitle" type="text" maxlength="60" required>
            </label>
            <label class="field">
                <span>站点描述</span>
                <input asp-for="Input.SiteDescription" type="text" maxlength="120">
            </label>
            <label class="field">
                <span>默认配色</span>
                <select asp-for="Input.ColorMode" asp-items="colorModes"></select>
            </label>
            <label class="field">
                <span>点点滴滴每页条数</span>
                <input asp-for="Input.MomentsPageSize" type="number" min="1" max="100">
            </label>
            <label class="field">
                <span>站点时区</span>
                <input asp-for="Input.TimeZone" type="text" maxlength="64" placeholder="Asia/Shanghai" list="timezone-options">
            </label>
        </div>
        <datalist id="timezone-options">
            <option value="Asia/Shanghai"></option>
            <option value="Asia/Hong_Kong"></option>
            <option value="Asia/Taipei"></option>
            <option value="Asia/Tokyo"></option>
            <option value="Asia/Singapore"></option>
            <option value="Europe/London"></option>
            <option value="America/New_York"></option>
            <option value="America/Los_Angeles"></option>
            <option value="UTC"></option>
        </datalist>
    </div>

    <div class="admin-panel">
        <h2>@Icon("heart")两个人</h2>
        <div class="field-grid">
            <label class="field">
                <span>男主名字</span>
                <input asp-for="Input.BoyName" type="text" maxlength="32" required>
            </label>
            <label class="field">
                <span>女主名字</span>
                <input asp-for="Input.GirlName" type="text" maxlength="32" required>
            </label>
            <label class="field">
                <span>男主头像地址</span>
                <input asp-for="Input.BoyAvatar" type="text" maxlength="500" placeholder="留空时显示文字头像">
            </label>
            <label class="field">
                <span>女主头像地址</span>
                <input asp-for="Input.GirlAvatar" type="text" maxlength="500" placeholder="留空时显示文字头像">
            </label>
            <label class="field">
                <span>男主个性短句</span>
                <input asp-for="Input.BoySentence" type="text" maxlength="60">
            </label>
            <label class="field">
                <span>女主个性短句</span>
                <input asp-for="Input.GirlSentence" type="text" maxlength="60">
            </label>
            <partial name="_DateField" model="@(DateFieldModel.Moment(
                "Input.LoveStartedAt",
                "在一起的时间",
                Model.Input.LoveStartedAt))" />
            <label class="field">
                <span>每天最多记多少次心动</span>
                <input asp-for="Input.HeartbeatDailyLimit" type="number" min="1" max="9999">
            </label>
        </div>
    </div>

    <div class="admin-panel">
        <h2>@Icon("quote")首页文案</h2>
        <label class="field">
            <span>首页介绍</span>
            <textarea asp-for="Input.HomeSentence" rows="2" maxlength="200"></textarea>
        </label>
        <label class="field">
            <span>今日恋爱小记</span>
            <textarea asp-for="Input.DailyNote" rows="3" maxlength="400"></textarea>
            <small>换行会原样保留。</small>
        </label>
        <label class="field" style="margin-bottom:0">
            <span>随机情话</span>
            <textarea asp-for="Input.LoveLetters" rows="8"></textarea>
            <small>一行一句，每次打开首页随机显示一句。</small>
        </label>
    </div>

    <div class="admin-panel">
        <h2>@Icon("image")附件存储</h2>
        <p class="admin-panel-hint">
            本地存储与 OSS 使用相同的路径规则。完整同步 <code>uploads</code> 后再切换存储策略，已有图片地址将保持不变。
        </p>
        <div class="field-grid">
            <label class="field">
                <span>存储策略</span>
                <select asp-for="Input.StorageDriver" asp-items="storageDrivers"></select>
                <small>当前生效：@Model.EffectiveDriverText</small>
            </label>
            <label class="field">
                <span>OSS Region</span>
                <input asp-for="Input.OssRegion" type="text" maxlength="64" placeholder="cn-beijing">
            </label>
            <label class="field">
                <span>OSS Bucket</span>
                <input asp-for="Input.OssBucket" type="text" maxlength="64">
            </label>
            <label class="field">
                <span>AccessKey ID</span>
                <input asp-for="Input.OssAccessKeyId" type="text" maxlength="128" autocomplete="off">
            </label>
            <label class="field">
                <span>AccessKey Secret</span>
                <input asp-for="Input.OssAccessKeySecret" type="password" maxlength="128" autocomplete="new-password">
            </label>
            <label class="field">
                <span>对外访问域名</span>
                <input asp-for="Input.OssPublicBaseUrl" type="text" maxlength="200" placeholder="https://img.example.com">
            </label>
            <label class="field">
                <span>自定义 API 端点</span>
                <input asp-for="Input.OssApiEndpoint" type="text" maxlength="200" placeholder="留空时根据 Region 自动生成">
            </label>
        </div>
    </div>

    <div class="admin-panel email-settings">
        <div class="panel-head">
            <h2>@Icon("mail")邮件通知</h2>
            <span class="channel-status" data-kind="@(Model.EmailConfigured ? "ok" : "muted")">
                @(Model.EmailConfigured ? "已就绪" : "未启用或配置不完整")
            </span>
        </div>
        <p class="admin-panel-hint">
            邮件与 Web Push 可以同时启用；单个渠道失败不会影响另一个渠道继续投递。
        </p>

        <label class="field-check email-master">
            <input asp-for="Input.EmailEnabled" type="checkbox">
            <span>启用站点邮件通知服务</span>
        </label>

        <div class="field-grid">
            <label class="field">
                <span>SMTP Host</span>
                <input asp-for="Input.EmailHost" type="text" maxlength="200" placeholder="smtp.example.com" autocomplete="off">
            </label>
            <label class="field">
                <span>SMTP Port</span>
                <input asp-for="Input.EmailPort" type="number" min="1" max="65535">
            </label>
            <label class="field">
                <span>连接加密</span>
                <select asp-for="Input.EmailSecurity" asp-items="emailSecurityOptions"></select>
            </label>
            <label class="field">
                <span>SMTP 用户名</span>
                <input asp-for="Input.EmailUsername" type="text" maxlength="320" autocomplete="off" placeholder="notify@example.com">
            </label>
            <label class="field">
                <span>SMTP 密码 / 邮箱授权码</span>
                <input asp-for="Input.EmailPassword" type="password" maxlength="500" autocomplete="new-password" placeholder="留空以保留现有密码">
            </label>
            <label class="field">
                <span>通知发送邮箱（From）</span>
                <input asp-for="Input.EmailSenderEmail" type="email" maxlength="320" placeholder="notify@example.com">
            </label>
            <label class="field">
                <span>发件人显示名称</span>
                <input asp-for="Input.EmailSenderName" type="text" maxlength="100" placeholder="Our Story">
            </label>
            <label class="field">
                <span>站点公开地址</span>
                <input asp-for="Input.EmailSiteBaseUrl" type="url" maxlength="500" placeholder="https://love.example.com">
            </label>
        </div>
    </div>

    @* 心意发放与价格区间仅允许男主账号配置。 *@
    @if (Model.CanEditHeartRules)
    {
        <div class="admin-panel">
            <h2>@Icon("coins")心意规则</h2>

            <p class="admin-panel-hint">
                心意用于记录彼此的投入。每项奖励每天最多获得一次，重复记录不会重复累计。
            </p>

            <div class="field-grid">
                <label class="field">
                    <span>每日来访</span>
                    <input asp-for="Input.RewardVisit" type="number" min="0" max="100">
                    <small>每日首次访问站点，就会收到一份心意</small>
                </label>

                <label class="field">
                    <span>每日首次想你</span>
                    <input asp-for="Input.RewardHeartbeat" type="number" min="0" max="100">
                    <small>每天第一次想起对方时，送上一份心意</small>
                </label>

                <label class="field">
                    <span>发布点点滴滴</span>
                    <input asp-for="Input.RewardMoment" type="number" min="0" max="100">
                    <small>内容正式发布后获得，每天最多一次。</small>
                </label>

                <label class="field">
                    <span>发布纪念日</span>
                    <input asp-for="Input.RewardAnniversary" type="number" min="0" max="100">
                    <small>纪念日正式发布后获得，每天最多一次</small>
                </label>

                <label class="field">
                    <span>心有灵犀答题</span>
                    <input asp-for="Input.RewardAffinity" type="number"
                           min="@HeartPointRules.MinAffinityReward" max="@HeartPointRules.MaxReward">
                    <small>每人完成每日题目时获得</small>
                </label>

                <label class="field">
                    <span>心愿最低价格</span>
                    <input asp-for="Input.ShopPriceMin" type="number" min="1" max="99999">
                </label>

                <label class="field">
                    <span>心愿最高价格</span>
                    <input asp-for="Input.ShopPriceMax" type="number" min="1" max="99999">
                    <small>用于限制单个心愿可设置的最高价格</small>
                </label>

                <label class="field">
                    <span>默认上架天数</span>
                    <input asp-for="Input.ShopListingDays" type="number" min="1" max="3650">
                    <small>新发布的心愿默认保持上架的天数</small>
                </label>

                <label class="field">
                    <span>默认有效天数</span>
                    <input asp-for="Input.ShopValidDays" type="number" min="1" max="3650">
                    <small>兑换后的默认使用期限，发布时可单独调整</small>
                </label>
            </div>
        </div>
    }

    <div class="admin-panel">
        <h2>@Icon("message-circle-heart")留言</h2>
        <label class="field-check">
            <input asp-for="Input.AllowGuestComments" type="checkbox">
            <span>允许访客留言</span>
        </label>
        <label class="field-check">
            <input asp-for="Input.CommentsRequireMail" type="checkbox">
            <span>留言必须填邮箱</span>
        </label>

        <div class="form-actions">
            <button class="btn" type="submit">@Icon("save")保存设置</button>
        </div>
    </div>
</form>
