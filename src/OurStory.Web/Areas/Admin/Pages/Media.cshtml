@page "/admin/media"
@model OurStory.Web.Areas.Admin.Pages.MediaModel
@{
    ViewData["ActiveMenu"] = "media";
    ViewData["Eyebrow"] = "MEDIA";
    ViewData["Title"] = "图片";
    var pager = new PaginationModel(Model.Items.Page, Model.Items.TotalPages, "/admin/media");
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <p class="admin-error">@Icon("circle-alert")@Model.Error</p>
}

<div class="admin-panel">
    <h2>@Icon("upload")上传</h2>
    <p class="admin-panel-hint">当前存储：@Model.DriverName</p>

    <form method="post" enctype="multipart/form-data" data-media-upload>
        <label class="field">
            <span>选择图片</span>
            <input type="file" name="files" accept="image/*" multiple required data-media-files>
            <ul class="file-picked" data-file-summary hidden></ul>
        </label>

        <partial name="_UploadProgress" />

        <div class="form-actions">
            <button class="btn" type="submit">@Icon("upload")上传</button>
        </div>
    </form>
</div>

<div class="admin-panel">
    <h2>@Icon("image")最近上传</h2>

    @if (!Model.IsLocal)
    {
        <p class="admin-empty">附件存在 OSS 上，这里不列清单，去 Bucket 里看就好。</p>
    }
    else if (Model.Items.Items.Count == 0)
    {
        <p class="admin-empty">还没有上传过图片。</p>
    }
    else
    {
        <p class="admin-panel-hint">一共 @Model.Items.TotalCount 张图片。</p>
        <div class="media-grid">
            @foreach (var item in Model.Items.Items)
            {
                <figure class="media-item">
                    @* 格子里挂的是压好的小图，点开才去拿原图 *@
                    <a class="media-thumb" href="@item.Url" target="_blank" rel="noopener" data-thumb>
                        <img src="@item.ThumbUrl" alt="@item.Name" width="720" height="540" loading="lazy" decoding="async">
                        <span class="media-thumb-failed">@Icon("circle-alert")<span>图片加载失败</span></span>
                    </a>
                    <figcaption>
                        <span class="media-name" title="@item.Name">@item.Name</span>
                        <span class="media-foot">
                            <span>@item.SizeText</span>
                            <button class="media-copy" type="button" data-copy="@item.Url">@Icon("copy")<span>复制链接</span></button>
                        </span>
                    </figcaption>
                </figure>
            }
        </div>

        <partial name="_Pagination" model="pager" />
    }
</div>
