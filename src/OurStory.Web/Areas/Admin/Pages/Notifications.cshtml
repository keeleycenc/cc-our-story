@page "/admin/notifications"
@model OurStory.Web.Areas.Admin.Pages.NotificationsModel
@inject AssetVersionProvider Assets
@{
    ViewData["ActiveMenu"] = "notifications";
    ViewData["Eyebrow"] = "NOTIFICATIONS";
    ViewData["Title"] = "通知中心";
}

@* 这一整块要靠脚本才有意义：授权、退订、试发都是浏览器那头的事。
   data-push 是脚本认这块内容的记号 *@
<div class="admin-panel" data-push>
    <div class="panel-head">
        <h2>@Icon("bell-ring")当前设备<span class="push-spinner" data-push-busy hidden aria-hidden="true"></span></h2>

        <button class="push-switch" type="button" role="switch" aria-checked="false"
                data-push-toggle data-state="busy" disabled>
            <span class="push-switch-label" data-push-label>正在检测</span>
            <span class="push-switch-track"><span class="push-switch-thumb"></span></span>
        </button>
    </div>

    <p class="admin-panel-hint">
        为了不错过彼此分享的每个瞬间，请分别在手机、平板或电脑上开启通知。
        根据浏览器的安全要求，每台设备都需要由你亲自确认授权。
    </p>

    @if (!Model.IsConfigured)
    {
        <p class="admin-error">@Icon("circle-alert")通知服务尚未完成配置，请联系站点管理员检查启动日志。</p>
    }

    <p class="push-status" data-push-status>正在检测当前设备的通知状态……</p>
</div>

<div class="admin-panel">
    <h2>@Icon("smartphone")接收通知的设备</h2>

    @if (Model.Devices.Count == 0)
    {
        <p class="admin-panel-hint" style="margin-bottom:0">尚无设备开启通知，开启后即可及时收到彼此的动态。</p>
    }
    else
    {
        <div class="device-list">
            @foreach (var device in Model.Devices)
            {
                <div class="device-card" data-device-key="@device.Key">
                    <span class="device-mark">@Icon("smartphone")</span>
                    <div class="device-body">
                        <strong>@device.Name<span class="device-current" hidden>本机</span></strong>
                        <span>
                            <span>@Icon("check")启用于 @device.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                            <span>@Icon("send")@(device.LastPushedAt is { } pushed ? "最近推送 " + pushed.ToString("MM-dd HH:mm") : "暂无推送记录")</span>
                        </span>
                        <span class="device-note" data-device-note hidden></span>
                    </div>
                    <div class="device-actions">
                        <button class="btn btn-ghost btn-small device-test" type="button" data-device-test="@device.Id">
                            <span class="push-spinner" aria-hidden="true"></span>
                            @Icon("send", "icon-idle")<span>发送测试</span>
                        </button>
                        <form method="post" asp-page-handler="RemoveDevice">
                            <input type="hidden" name="deviceId" value="@device.Id">
                            <button class="btn btn-danger btn-small" type="submit">@Icon("trash-2")移除</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>

<form method="post" class="admin-panel" data-notify-form>
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <p class="admin-error">@Icon("circle-alert")@Model.Error</p>
    }

    <h2>@Icon("list-checks")通知偏好</h2>
    <p class="admin-panel-hint">
        你和对方可以分别选择希望接收的提醒，彼此的设置互不影响。关闭总开关后，本账号将仅接收测试通知
    </p>

    <div class="notify-options">
        <label class="notify-option">
            <input asp-for="Input.Enabled" type="checkbox" data-notify-master>
            <span>
                <strong>接收通知</strong>
                <small>总开关。关掉之后，下面几项就都不会再打扰你了</small>
            </span>
        </label>
    </div>

    <div class="notify-options" data-notify-group>
        <label class="notify-option">
            <input asp-for="Input.Moments" type="checkbox">
            <span>
                <strong>@Icon("camera")点点滴滴</strong>
                <small>对方记录下新的一条时提醒我</small>
            </span>
        </label>

        <label class="notify-option">
            <input asp-for="Input.Anniversaries" type="checkbox">
            <span>
                <strong>@Icon("calendar-heart")纪念日</strong>
                <small>对方添加新日子时，以及纪念日在今天或明天到来时</small>
            </span>
        </label>

        <label class="notify-option">
            <input asp-for="Input.Shop" type="checkbox">
            <span>
                <strong>@Icon("store")心意商城</strong>
                <small>心意上架、兑换、等待确认或圆满完成时</small>
            </span>
        </label>

        <label class="notify-option">
            <input asp-for="Input.MissYou" type="checkbox">
            <span>
                <strong>@Icon("heart")想你</strong>
                <small>对方在首页点了想你之后提醒</small>
            </span>
        </label>

        <label class="notify-option">
            <input asp-for="Input.Comments" type="checkbox">
            <span>
                <strong>@Icon("message-circle-heart")留言</strong>
                <small>点点滴滴有新留言时提醒</small>
            </span>
        </label>

        <label class="notify-option">
            <input asp-for="Input.Affinity" type="checkbox">
            <span>
                <strong>@Icon("sparkles")心有灵犀</strong>
                <small>对方回答了今天的问题时提醒我</small>
            </span>
        </label>

        <label class="notify-option notify-time">
            <span>
                <strong>@Icon("clock")纪念日提醒时间</strong>
                <small>当天或次日有纪念日时，会在这个时刻提醒一次，时间以站点时区为准</small>
            </span>
        </label>

        <label class="field notify-time-field">
            <input asp-for="Input.RemindAt" type="time">
        </label>
    </div>

    <div class="form-actions">
        <button class="btn" type="submit">@Icon("save")保存设置</button>
    </div>
</form>

<div class="admin-panel">
    <h2>@Icon("send")给@(Model.PartnerName)送去一句话</h2>
    <p class="admin-panel-hint">
        会直接送达@(Model.PartnerName)所有已开启通知的设备，不受分类偏好影响。
    </p>

    @if (Model.PartnerBlockedReason is { } blocked)
    {
        <p class="push-status" data-kind="warn">@Icon("bell-off")@blocked。</p>
    }
    else
    {
        <p class="push-status" data-kind="ok">@Icon("bell-ring")@(Model.PartnerName)已开启通知，共 @Model.Partner.Devices 台设备可以收到。</p>
    }

    <form data-push-send>
        <label class="field">
            <span>想对对方说的话</span>
            <textarea rows="3" maxlength="120" placeholder="今天也很想你，愿你一切都好"
                      data-push-body @(Model.PartnerBlockedReason is null ? null : "disabled")></textarea>
            <small>最多 120 字。受设备显示空间影响，锁屏通知可能仅展示前一至两行。</small>
        </label>

        <p class="push-status" data-push-feedback></p>

        <div class="form-actions" style="margin-top:0">
            <button class="btn push-send" type="submit" @(Model.PartnerBlockedReason is null ? null : "disabled")>
                <span class="push-spinner" aria-hidden="true"></span>
                @Icon("send", "icon-idle")<span>送达心意</span>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="@Assets.Url("assets/push.js")" defer></script>
}
