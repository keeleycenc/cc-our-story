@page "/admin/moments/edit/{id:int?}"
@model OurStory.Web.Areas.Admin.Pages.Moments.EditModel
@{
    ViewData["ActiveMenu"] = "moments";
    ViewData["Eyebrow"] = Model.IsNew ? "NEW MOMENT" : "EDIT MOMENT";
    ViewData["Title"] = Model.IsNew ? "写一条记录" : "编辑记录";
    ViewData["BackUrl"] = "/admin/moments";
}
<form method="post" data-dirty-guard>
    @if (!ViewData.ModelState.IsValid)
    {
        <p class="admin-error">@Icon("circle-alert")@Html.Raw(string.Join("；", ViewData.ModelState.Values.SelectMany(state => state.Errors).Select(error => error.ErrorMessage)))</p>
    }

    <div class="editor-layout">
        <div class="editor-body">
            <div class="admin-panel">
                <label class="field">
                    <span>标题</span>
                    <input asp-for="Input.Title" type="text" maxlength="180" required autofocus>
                </label>

                <partial name="_MarkdownImageEditor" model="@(new MarkdownEditorModel(
                    "Input.Content",
                    "正文（Markdown）",
                    Model.Input.Content,
                    "Input.CoverUrl",
                    Model.Input.CoverUrl,
                    "写下这一刻发生的故事……",
                    "支持 Markdown、表格和任务列表；上传图片后会直接插入正文。"))" />
            </div>
        </div>

        <div class="editor-side">
            <div class="admin-panel">
                <h2>@Icon("save")发布</h2>

                <label class="field">
                    <span>状态</span>
                    <select asp-for="Input.Status" asp-items="Html.GetEnumSelectList<MomentStatus>()"></select>
                </label>

                <partial name="_DateField" model="@(DateFieldModel.Date(
                    "Input.MomentDate",
                    "发生日期",
                    Model.Input.MomentDate,
                    hint: "可以补记很久以前的事，时间轴按它排。"))" />

                <label class="field-check">
                    <input asp-for="Input.AllowComment" type="checkbox">
                    <span>允许留言</span>
                </label>

                <div class="form-actions">
                    <button class="btn" type="submit">@Icon("save")保存</button>
                    @if (!Model.IsNew && Model.Slug is not null)
                    {
                        <a class="btn btn-ghost" href="/moments/@Model.Slug" target="_blank" rel="noopener">@Icon("eye")预览</a>
                    }
                </div>
            </div>

            <div class="admin-panel">
                <h2>@Icon("tag")这一刻</h2>

                <label class="field">
                    <span>心情</span>
                    <input asp-for="Input.Mood" type="text" maxlength="32" placeholder="开心 / 想念 / 被治愈">
                </label>

                <label class="field">
                    <span>地点</span>
                    <input asp-for="Input.Location" type="text" maxlength="120" placeholder="北京 · 颐和园">
                </label>

                <label class="field">
                    <span>摘要</span>
                    <textarea asp-for="Input.Summary" rows="3" maxlength="400" placeholder="留空时自动从正文截取"></textarea>
                </label>

                <label class="field">
                    <span>地址短名</span>
                    <input asp-for="Input.Slug" type="text" maxlength="80" placeholder="留空时自动生成">
                </label>

                <label class="field" style="margin-bottom:0">
                    <span>访问密码</span>
                    <input asp-for="Input.Password" type="text" maxlength="128" placeholder="不为空即上锁">
                </label>
            </div>
        </div>
    </div>
</form>
