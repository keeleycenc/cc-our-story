@page "/admin/affinity"
@model OurStory.Web.Areas.Admin.Pages.Affinity.IndexModel
@{
    ViewData["ActiveMenu"] = "affinity";
    ViewData["Eyebrow"] = "SEALED QUESTIONS";
    ViewData["Title"] = "心有灵犀题目";
    var pager = new PaginationModel(Model.Questions.Page, Model.Questions.TotalPages, "/admin/affinity");
}

<div class="admin-panel">
    <div class="admin-toolbar affinity-toolbar">
        <div>
            <strong>封存记录</strong>
            <p class="admin-panel-hint">共 @Model.Questions.TotalCount 份。创建后不会再显示内容，也不能编辑或删除。</p>
        </div>
        <a class="btn" href="/admin/affinity/create">@Icon("plus")创建题目</a>
    </div>

    @if (Model.Questions.TotalCount == 0)
    {
        <div class="admin-empty affinity-admin-empty">
            <span>@Icon("sparkles")</span>
            <strong>暂无封存题目</strong>
            <p>创建题目后会按顺序等待使用，并始终保持内容安全。</p>
        </div>
    }
    else
    {
        <div class="sealed-question-grid">
            @foreach (var question in Model.Questions.Items)
            {
                <article class="sealed-question-card">
                    <header>
                        <span class="sealed-question-mark">@Icon("lock")</span>
                        <div>
                            <span>SEALED QUESTION</span>
                            <strong>封存题目 #@question.Id.ToString("D3")</strong>
                        </div>
                        <span class="tag affinity-sealed-tag">已封存</span>
                    </header>

                    <div class="sealed-question-summary">
                        <span>@Icon("tag")<small>分类</small><strong>@question.Category</strong></span>
                        <span>@Icon("list-checks")<small>选项</small><strong>@(question.Type == AffinityQuestionType.OpenEnded ? "无需选项" : $"{question.OptionCount} 项")</strong></span>
                        <span>@Icon("coins")<small>固定奖励</small><strong>@question.RewardPoints 心意</strong></span>
                        <span>@Icon("user-round")<small>创建者</small><strong>@question.CreatorName</strong></span>
                    </div>

                    <footer>
                        <span>@Icon("calendar-days")创建于 @question.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                        <span>@Icon(question.UsedCount > 0 ? "circle-check" : "hourglass")@(question.UsedCount > 0 ? "已使用" : "等待使用")</span>
                        <span>@Icon("sparkles")@(question.Type switch { AffinityQuestionType.SingleChoice => "单选题", AffinityQuestionType.MultipleChoice => "多选题", AffinityQuestionType.OpenEnded => "开放题", _ => question.Type.ToString() })</span>
                    </footer>
                </article>
            }
        </div>

        <partial name="_Pagination" model="pager" />
    }
</div>
