@inject AssetVersionProvider Assets
@inject ISettingsService SettingsService
@{
	var site = await SettingsService.GetAsync();
	var active = ViewData["ActiveMenu"] as string ?? string.Empty;
	var flash = TempData["Flash"] as string;

	// Quick 决定这一项会不会摆到手机顶栏上。总览固定在第一格，后面跟两个常用管理入口。
	var menu = new (string Key, string Url, string Icon, string Label, bool Quick)[]
	{
		("dashboard", "/admin", "layout-dashboard", "总览", true),
		("moments", "/admin/moments", "camera", "点点滴滴", true),
		("anniversaries", "/admin/anniversaries", "calendar-heart", "纪念日", true),
		("affinity", "/admin/affinity", "sparkles", "心有灵犀", false),
		("shop", "/admin/shop", "store", "心意商城", false),
		("comments", "/admin/comments", "message-circle-heart", "留言", false),
		("atmosphere", "/admin/atmosphere", "users-round", "氛围组", false),
		("cycles", "/admin/cycles", "calendar-days", "花信如期", false),
		("media", "/admin/media", "image", "图片", false),
		("notifications", "/admin/notifications", "bell", "通知", false),
		("settings", "/admin/settings", "settings", "站点设置", false),
		("account", "/admin/account", "key-round", "账号", false)
	};

	var quick = menu.Where(item => item.Quick).Take(3).ToArray();
}
<!doctype html>
<html lang="zh-CN">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="theme-color" content="#fffaf8" media="(prefers-color-scheme: light)">
	<meta name="theme-color" content="#17151b" media="(prefers-color-scheme: dark)">
	<title>@ViewData["Title"] · @site.SiteTitle 后台</title>
	<link rel="icon" href="/favicon.ico">
	<link rel="manifest" href="/manifest.webmanifest">
	<link rel="apple-touch-icon" href="/assets/icons/icon-180.png">
	<meta name="apple-mobile-web-app-capable" content="yes">
	<meta name="apple-mobile-web-app-title" content="@site.SiteTitle">
	<link rel="stylesheet" href="@Assets.Url("assets/variables.css")">
	<link rel="stylesheet" href="@Assets.Url("assets/admin.css")">
	<link rel="stylesheet" href="@Assets.Url("assets/datefield.css")">
	<link rel="stylesheet" href="@Assets.Url("assets/lightbox.css")">
	<link rel="stylesheet" href="@Assets.Url("assets/pagination.css")">
	<script>
			(function () {
				var mode = null;
				try { mode = localStorage.getItem('cc-color-mode'); } catch (e) {}
				if (mode !== 'light' && mode !== 'dark') {
					mode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				}

				document.documentElement.dataset.theme = mode;
				document.documentElement.classList.add('has-js');
			}());
	</script>
</head>
<body class="admin">
	@Sprite()

	@* 移动端顶栏包含站名、常用入口、配色切换与完整导航入口。
	   导航位于页面顶部，内容区域独立滚动。 *@
	<header class="admin-bar">
		<a class="admin-logo" href="/"><span>CC</span> Our Story</a>
		<nav class="admin-bar-nav" aria-label="常用入口">
			@foreach (var item in quick)
			{
				<a href="@item.Url" class="@(active == item.Key ? "is-active" : null)" title="@item.Label" aria-label="@item.Label">@Icon(item.Icon)</a>
			}
			<button class="admin-theme" type="button" data-theme-toggle aria-label="切换配色">@Icon("sun", "icon-sun")@Icon("moon-star", "icon-moon")</button>
			<button class="admin-more" type="button" data-sheet-open aria-controls="admin-more" aria-expanded="false" aria-label="更多">@Icon("ellipsis")</button>
		</nav>
	</header>

	<div class="admin-shell">
		<aside class="admin-side">
			<a class="admin-logo" href="/"><span>CC</span> Our Story</a>
			<nav aria-label="后台导航">
				@foreach (var item in menu)
				{
					<a href="@item.Url" class="@(active == item.Key ? "is-active" : null)">@Icon(item.Icon)<span>@item.Label</span></a>
				}
			</nav>
			<div class="admin-side-foot">
				<a href="/" target="_blank" rel="noopener">@Icon("house")<span>查看站点</span></a>
				<a href="/logout">@Icon("log-out")<span>退出</span></a>
			</div>
		</aside>

		@* 内容区域限宽并居中显示，以保证宽屏下的可读性。 *@
		<main class="admin-main">
			<div class="admin-canvas">
				<header class="admin-top">
					<div>
						<p>@ViewData["Eyebrow"]</p>
						<h1>@ViewData["Title"]</h1>
						@* 编辑页面在标题区域提供返回入口，表单底部保留主要操作。 *@
						@if (ViewData["BackUrl"] is string backUrl)
						{
							<a class="admin-back" href="@backUrl">@Icon("arrow-left")@(ViewData["BackText"] as string ?? "返回列表")</a>
						}
					</div>
					<div class="admin-who">
						@Icon("user-round")<span>@site.RoleName(User.Role())</span>
						<button class="admin-theme" type="button" data-theme-toggle aria-label="切换配色">@Icon("sun", "icon-sun")@Icon("moon-star", "icon-moon")</button>
					</div>
				</header>

				@if (!string.IsNullOrEmpty(flash))
				{
					<p class="admin-flash">@Icon("check")@flash</p>
				}

				@RenderBody()
			</div>
		</main>
	</div>

	@* 回到顶部按钮滚动独立的 .admin-main 内容区域。 *@
	<button class="admin-to-top" type="button" aria-label="回到顶部" title="回到顶部" hidden>@Icon("arrow-up")</button>

	@* 「更多」面板在移动端承载完整后台导航。 *@
	<div class="admin-sheet" id="admin-more" data-sheet>
		<div class="admin-sheet-mask" data-sheet-close></div>
		<div class="admin-sheet-card" role="dialog" aria-modal="true" aria-label="后台导航">
			<div class="admin-sheet-handle"></div>
			<p class="admin-sheet-who">@Icon("user-round")<span>@site.RoleName(User.Role())</span></p>
			<div class="admin-sheet-links">
				@foreach (var item in menu)
				{
					<a href="@item.Url" class="@(active == item.Key ? "is-active" : null)">@Icon(item.Icon)<span>@item.Label</span></a>
				}
				<a href="/" target="_blank" rel="noopener">@Icon("house")<span>查看站点</span></a>
				<a href="/logout">@Icon("log-out")<span>退出</span></a>
			</div>
			<button class="btn btn-ghost admin-sheet-dismiss" type="button" data-sheet-close>@Icon("x")收起</button>
		</div>
	</div>

	<script src="@Assets.Url("assets/pwa.js")" defer></script>
	<script src="@Assets.Url("assets/lightbox.js")" defer></script>
	<script src="@Assets.Url("assets/datefield.js")" defer></script>
	<script src="@Assets.Url("assets/admin.js")" defer></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
