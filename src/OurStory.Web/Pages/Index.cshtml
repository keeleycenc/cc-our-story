@page "/"
@model IndexModel
@inject System.Text.Encodings.Web.HtmlEncoder Encoder
@{
    ViewData["ActiveNav"] = "home";
    ViewData["Bundle"] = "home";

    var site = Model.Site;
    var heart = Model.Heartbeat;
    var isGuest = Model.IsGuest;
    var heartHint = isGuest ? "送上一句祝福" : "点一下，告诉对方你在想他";
    var loveStart = site.LoveStartedAt.ToString("yyyy-MM-dd HH:mm:ss");

    var momentsHint = Model.MomentsCount > 0 ? $"已经收藏 {Model.MomentsCount} 个瞬间" : "写下第一个瞬间";
    var features = new (string Icon, string Title, string Description, string Tone, string Hint, string Url)[]
    {
        ("camera", "点点滴滴", "收藏照片、文字与每个值得记住的小瞬间", "peach", momentsHint, "/moments"),
        ("list-checks", "我们的清单", "一起想做的事，完成一件就点亮一颗星", "mint", "等待接入数据", ""),
        ("history", "时光机", "随机回到过去的某一天，重温当时的心情", "blue", "开启一段回忆", ""),
        ("calendar-heart", "纪念日", "把重要日期放进时间轴，回看故事，也不错过下一次相逢", "rose", Model.AnniversariesCount > 0 ? $"已记录 {Model.AnniversariesCount} 个重要日子" : "记录第一个重要日子", "/anniversaries"),
        ("mail", "留言信箱", "写下此刻想对彼此说、又有点害羞的话", "lilac", "悄悄留一句话", ""),
        ("book-heart", "恋爱小记", "看看我们一起走过的时间与共同足迹", "gold", "本月暂无记录", "")
    };
}
<main id="main">
    <section class="home-hero">
        <div class="hero-content">
            <p class="kicker"><i></i> WELCOME TO OUR LITTLE WORLD <i></i></p>
            <h1>两个人的<span>小宇宙</span></h1>
            <p class="subtitle">@site.HomeSentence</p>

            <div class="couple">
                <article class="person person-left">
                    <partial name="_Avatar" model="@(new AvatarModel(site.BoyAvatar, "我", "avatar-boy"))" />
                    <div>
                        <p>BOY</p>
                        <h2>@site.BoyName</h2><span class="person-line">@site.BoySentence</span>
                        <span class="miss-count@(heart.Role == "boy" ? " is-mine" : "")" data-heart-count="boy">@Icon("heart")想你 <strong>@heart.Totals.GetValueOrDefault("boy")</strong></span>
                    </div>
                </article>

                <div class="love-mark">
                    <button class="heart" type="button"
                            data-heart
                            data-heart-role="@heart.Role"
                            data-heart-limit="@heart.DailyLimit"
                            data-heart-self-today="@heart.Self.Today"
                            data-heart-endpoint="/api/heartbeat"
                            data-heart-token="@Model.HeartbeatToken"
                            aria-label="@heartHint"
                            title="@heartHint">@Icon("heart")</button>
                    <span>LOVE</span>
                    <span class="guest-count@(isGuest ? " is-mine" : "")" data-heart-count="guest">@Icon("sparkles")祝福 <strong>@heart.Totals.GetValueOrDefault("guest")</strong></span>
                </div>

                <article class="person person-right">
                    <partial name="_Avatar" model="@(new AvatarModel(site.GirlAvatar, "她", "avatar-girl"))" />
                    <div>
                        <p>GIRL</p>
                        <h2>@site.GirlName</h2><span class="person-line">@site.GirlSentence</span>
                        <span class="miss-count@(heart.Role == "girl" ? " is-mine" : "")" data-heart-count="girl">@Icon("heart")想你 <strong>@heart.Totals.GetValueOrDefault("girl")</strong></span>
                    </div>
                </article>
            </div>

            <div class="together" data-love-start="@loveStart">
                <p class="together-letter">@Icon("heart")<span>@Model.LoveLetter</span></p>
                <div class="timer" aria-live="polite">
                    <div><strong data-time="days">0</strong><span>天</span></div><b>:</b>
                    <div><strong data-time="hours">00</strong><span>小时</span></div><b>:</b>
                    <div><strong data-time="minutes">00</strong><span>分钟</span></div><b>:</b>
                    <div><strong data-time="seconds">00</strong><span>秒</span></div>
                </div>
                <small>始于 @loveStart · 至今</small>

                <div class="heart-board">
                    <div class="heart-board-label"><span>LOVE LETTER</span><i></i><span>心动珍藏</span></div>
                    <p>@Icon("heart")以 <b>@Model.RoleName()</b> 的身份，@(isGuest ? "点亮爱心送上祝福" : "把此刻的想念留在这里")</p>
                    <div class="board-grid" aria-live="polite">
                        <div><strong data-heart-stat="today">@heart.Display.Today</strong><span>今天</span></div>
                        <div><strong data-heart-stat="streak">@heart.Display.Streak</strong><span>@(isGuest ? "祝福人数" : "连续天数")</span></div>
                        <div><strong data-heart-stat="best">@heart.Display.Best</strong><span>@(isGuest ? "单日最高" : "心动天数")</span></div>
                        <div><strong data-heart-stat="total">@heart.Display.Total</strong><span>累计</span></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="float float-one">@Icon("heart")</div>
        <div class="float float-two">@Icon("sparkles")</div>
        <div class="float float-three">@Icon("heart")</div>
    </section>

    <section class="feature-section" id="our-space">
        <div class="section-title">
            <div>
                <p>OUR SPACE</p>
                <h2>我们的专属空间</h2>
            </div>
            <span>生活不止今天，还有很多值得期待的明天。</span>
        </div>
        <div class="feature-grid">
            @for (var index = 0; index < features.Length; index++)
            {
                var feature = features[index];
                var number = (index + 1).ToString("00");

                if (feature.Url.Length > 0)
                {
                    <a class="feature-card @feature.Tone" href="@feature.Url">
                        <span class="card-top"><span class="feature-icon">@Icon(feature.Icon)</span><small>@number</small></span>
                        <h3>@feature.Title</h3>
                        <p>@feature.Description</p>
                        <span class="card-bottom"><span>@feature.Hint</span>@Icon("arrow-right", "card-arrow")</span>
                    </a>
                }
                else
                {
                    <button class="feature-card @feature.Tone" type="button" data-feature="@feature.Title" data-feature-icon="@feature.Icon">
                        <span class="card-top">
                            <span class="feature-icon">@Icon(feature.Icon)</span>
                            <span class="card-meta"><small>@number</small><span class="feature-status">未开放</span></span>
                        </span>
                        <h3>@feature.Title</h3>
                        <p>@feature.Description</p>
                        <span class="card-bottom"><span>@feature.Hint</span>@Icon("arrow-right", "card-arrow")</span>
                    </button>
                }
            }
        </div>

        @if (Model.LatestMoments.Count > 0)
        {
            <section class="recent-moments" aria-labelledby="recent-moments-title">
                <div class="section-title">
                    <div>
                        <p>LATEST MOMENTS</p>
                        <h2 id="recent-moments-title">最近的点点滴滴</h2>
                    </div>
                    <a class="section-more" href="/moments">全部记录@(Icon("arrow-right"))</a>
                </div>
                <div class="recent-grid">
                    @foreach (var moment in Model.LatestMoments)
                    {
                        <a class="recent-card" href="@moment.Url">
                            <span class="recent-cover">
                                @if (moment.CoverUrl.Length > 0)
                                {
                                    <img src="@moment.CoverUrl" alt="@moment.Title" loading="lazy" decoding="async">
                                }
                                else
                                {
                                    @Icon(moment.IsLocked ? "lock" : "image", "cover-placeholder")
                                }
                            </span>
                            <span class="recent-body">
                                <span class="recent-meta">@Icon("calendar-days")@moment.MomentDate.ToString("yyyy.MM.dd")@if (moment.LoveDay > 0)
                                    {<em>第 @moment.LoveDay 天</em>}</span>
                                <strong>@moment.Title</strong>
                                <span class="recent-excerpt">@moment.Excerpt</span>
                            </span>
                        </a>
                    }
                </div>
            </section>
        }

        <div class="daily-note">
            @Icon("quote", "note-quote")
            <p>@HtmlLines.WithBreaks(site.DailyNote, Encoder)</p>
            <small>— 今日恋爱小记</small>
        </div>
    </section>
</main>
