@page "/moments"
@model OurStory.Web.Pages.Moments.IndexModel
@inject MediaUrls Media
@{
    ViewData["ActiveNav"] = "moments";
    ViewData["Bundle"] = "moments";
    ViewData["Title"] = "点点滴滴";

    string? lastYear = null;
    var pager = new PaginationModel(Model.Items.Page, Model.Items.TotalPages, "/moments");
}
<main class="content-page moments-page" id="main">
    <header class="page-heading moments-heading">
        <p>OUR MOMENTS</p>
        <h1>点点滴滴</h1>
        <span>日子没有大小，和你有关的每一刻都值得收藏。</span>
        <div class="moments-stats">
            <span>@Icon("camera")@Model.TotalCount 个瞬间</span>
            @if (Model.LoveDays > 0)
            {
                <span>@Icon("heart")相恋第 @Model.LoveDays 天</span>
            }
        </div>
        @if (User.IsOwner())
        {
            <a class="write-moment" href="/admin/moments/edit">@Icon("pen-line")记录这一刻</a>
        }
    </header>

    @if (Model.Items.Items.Count > 0)
    {
        <div class="moment-timeline">
            @foreach (var moment in Model.Items.Items)
            {
                var year = moment.MomentDate.ToString("yyyy");
                if (year != lastYear)
                {
                    lastYear = year;
                    <p class="timeline-year"><span>@year</span></p>
                }

                <article class="moment-entry">
                    <div class="moment-date">
                        <strong>@moment.MomentDate.ToString("dd")</strong>
                        <span>@moment.MomentDate.ToString("MMM", System.Globalization.CultureInfo.InvariantCulture).ToUpperInvariant()</span>
                        <small>@moment.MomentDate.ToString("yyyy")</small>
                    </div>
                    <span class="timeline-dot" aria-hidden="true"></span>
                    <a class="moment-card@(moment.CoverUrl.Length > 0 ? " has-cover" : "")@(moment.IsLocked ? " is-locked" : "")" href="@moment.Url">
                        @if (moment.CoverUrl.Length > 0)
                        {
                            <span class="moment-cover" data-cover><img src="@Media.Cover(moment.CoverUrl)" alt="@moment.Title" loading="lazy" decoding="async"></span>
                        }
                        <div class="moment-content">
                            <span class="moment-meta">
                                <i>@Icon("heart")@moment.Mood</i>
                                @if (moment.Location.Length > 0)
                                {
                                    <em>@Icon("map-pin")@moment.Location</em>
                                }
                                @if (moment.LoveDay > 0)
                                {
                                    <em class="love-day">@Icon("clock")第 @moment.LoveDay 天</em>
                                }
                                @if (moment.IsLocked)
                                {
                                    <em class="locked-tag">@Icon("lock")已上锁</em>
                                }
                            </span>
                            <h2>@moment.Title</h2>
                            <span class="moment-excerpt">@moment.Excerpt</span>
                            <span class="moment-footer"><span>@Icon("user-round")由 @moment.AuthorName 记录</span><b>@(moment.IsLocked ? "输入密码打开" : "查看这段回忆")@Icon("arrow-right")</b></span>
                        </div>
                    </a>
                </article>
            }
        </div>
        <partial name="_Pagination" model="pager" />
    }
    else
    {
        <section class="moment-empty">
            @Icon("heart")
            <h2>第一段回忆，等你们来写</h2>
            <p>登录后台，在「点点滴滴」里写下第一条记录。</p>
            @if (User.IsOwner())
            {
                <a class="write-moment" href="/admin/moments/edit">@Icon("pen-line")现在就写一条</a>
            }
        </section>
    }
</main>
