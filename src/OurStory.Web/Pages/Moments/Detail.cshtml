@page "/moments/{slug}"
@model OurStory.Web.Pages.Moments.DetailModel
@{
    ViewData["ActiveNav"] = "moments";
    ViewData["Bundle"] = "moments";
    ViewData["Title"] = Model.Detail.Title;

    var detail = Model.Detail;
}
<main class="article-page moment-article" id="main">
    <article>
        <header>
            <a class="back-moments" href="/moments">@Icon("arrow-left")返回点点滴滴</a>
            <div class="article-moment-meta">
                <span>@Icon("heart")@detail.Mood</span>
                @if (detail.Location.Length > 0)
                {
                    <span>@Icon("map-pin")@detail.Location</span>
                }
                @if (detail.LoveDay > 0)
                {
                    <span>@Icon("clock")相恋第 @detail.LoveDay 天</span>
                }
            </div>
            <time datetime="@detail.MomentDate.ToString("yyyy-MM-ddTHH:mm:ss")">@detail.MomentDate.ToString("yyyy 年 MM 月 dd 日")</time>
            <h1>@detail.Title</h1>
            <p class="article-byline">
                <span>@Icon("user-round")由 @detail.AuthorName 记录</span>
                <a href="#comments">@Icon("message-circle-heart")@(detail.CommentCount switch { 0 => "暂无留言", 1 => "1 条留言", var count => $"{count} 条留言" })</a>
            </p>
        </header>
        <div class="article-body">
            @if (detail.IsLocked)
            {
                <form class="protected" method="post" asp-page-handler="Unlock">
                    <p class="word">这是一段上了锁的回忆，输入密码后查看</p>
                    <p>
                        <input type="password" name="protectPassword" class="text" autocomplete="current-password" required>
                        <input type="submit" class="submit" value="提交">
                    </p>
                </form>
            }
            else
            {
                @Model.Story
            }
        </div>
    </article>

    <nav class="post-nav" aria-label="上一篇 / 下一篇">
        @if (detail.Previous is not null)
        {
            <a class="post-nav-item" href="@detail.Previous.Url" rel="prev">
                <span class="post-nav-label">@Icon("arrow-left")更早的一篇</span>
                <span class="post-nav-title">@detail.Previous.Title</span>
            </a>
        }
        else
        {
            <div class="post-nav-item is-empty">
                <span class="post-nav-label">@Icon("arrow-left")更早的一篇</span>
                <span class="post-nav-title">已经是最早的记录了</span>
            </div>
        }

        @if (detail.Next is not null)
        {
            <a class="post-nav-item is-next" href="@detail.Next.Url" rel="next">
                <span class="post-nav-label">更新的一篇@(Icon("arrow-right"))</span>
                <span class="post-nav-title">@detail.Next.Title</span>
            </a>
        }
        else
        {
            <div class="post-nav-item is-next is-empty">
                <span class="post-nav-label">更新的一篇@(Icon("arrow-right"))</span>
                <span class="post-nav-title">已经是最新的记录了</span>
            </div>
        }
    </nav>

    <partial name="_Comments" model="Model.Comments" />
</main>
