@page "/affinity"
@model OurStory.Web.Pages.Affinity.IndexModel
@{
    ViewData["Title"] = "心有灵犀";
    ViewData["ActiveNav"] = "affinity";
    ViewData["Bundle"] = "affinity";
    var today = Model.Dashboard.Today;
    var stats = Model.Dashboard.Stats;
}

<main id="main" class="affinity-page">
    <section class="affinity-hero">
        <span class="affinity-mark">@Icon("sparkles")</span>
        <p>DAILY MIND SYNC</p>
        <h1>心有灵犀</h1>
        <span>每天一个小问题，看看你们到底有多懂彼此</span>
        <a class="affinity-manage" href="/admin/affinity">@Icon("pen-line")管理心有灵犀</a>
    </section>

    <div class="affinity-shell">
        @if (!string.IsNullOrWhiteSpace(Model.Flash))
        {
            <p class="affinity-notice is-ok">@Icon("circle-check")@Model.Flash</p>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <p class="affinity-notice is-error">@Icon("circle-alert")@Model.Error</p>
        }

        <section class="affinity-stats" aria-label="默契统计">
            <article class="affinity-stat is-rose"><span>@Icon("message-circle-heart")我的答题</span><strong>@stats.AnsweredDays</strong><small>个认真回答的日子</small></article>
            <article class="affinity-stat is-gold"><span>@Icon("history")连续答题</span><strong>@stats.CurrentStreak</strong><small>天正在延续的默契</small></article>
            <article class="affinity-stat is-mint"><span>@Icon("eye")共同揭晓</span><strong>@stats.RevealedDays</strong><small>次一起打开的答案</small></article>
            <article class="affinity-stat is-lilac"><span>@Icon("heart")默契次数</span><strong>@stats.MatchedDays</strong><small>次想到了一起</small></article>
            <article class="affinity-stat is-rate"><span>@Icon("sparkles")默契率</span><strong>@stats.MatchRate<small>%</small></strong><small>共同答案中的同频比例</small></article>
        </section>

        @if (today is null)
        {
            <section class="today-card affinity-empty">
                <span>@Icon("sparkles")</span>
                <h2>今天的题目还在路上</h2>
                <p>题库中暂时没有启用的题目，请先在后台添加或启用题目。</p>
                <a class="affinity-button" href="/admin/affinity">管理题库</a>
            </section>
        }
        else
        {
            var creatorName = today.CreatorRole is { } creatorRole
                ? Model.Site.RoleName(creatorRole)
                : "系统预置";
            <section class="today-card@(today.IsRevealed ? " is-revealed" : today.HasAnswered ? " is-waiting" : null)">
                <header>
                    <span class="today-label">@creatorName · 今日问题 · @today.Day.Replace("-", ".")</span>
                    <span class="today-tags">
                        @if (today.LoveDay > 0)
                        {
                            <span class="today-love-day">@Icon("clock")第 @today.LoveDay 天</span>
                        }
                        <span class="question-type">@(today.Type switch { AffinityQuestionType.MultipleChoice => "多选 · 可选多项", AffinityQuestionType.OpenEnded => "开放题 · 自由作答", _ => "单选" })</span>
                        <span class="category">@today.Category</span>
                    </span>
                </header>
                <h2>@today.Question</h2>

                @if (!today.HasAnswered)
                {
                    <form method="post" asp-page-handler="Answer" class="answer-form" data-answer-form>
                        <input type="hidden" name="dailyQuestionId" value="@today.DailyQuestionId">
                        @if (today.Type == AffinityQuestionType.OpenEnded)
                        {
                            <label class="open-answer-field">
                                <span>写下你的回答</span>
                                <textarea name="textAnswer" rows="5" maxlength="1000" required
                                          placeholder="把此刻真实的想法告诉 TA……"></textarea>
                                <small>最多 1000 字；双方提交后才会一起揭晓</small>
                            </label>
                        }
                        else
                        {
                            <fieldset>
                                @for (var index = 0; index < today.Options.Count; index++)
                                {
                                    var letter = ((char)('A' + index)).ToString();
                                    <label class="answer-option">
                                        <input type="@(today.Type == AffinityQuestionType.MultipleChoice ? "checkbox" : "radio")"
                                               name="optionIndexes" value="@index" required="@(today.Type == AffinityQuestionType.SingleChoice ? "required" : null)">
                                        <span class="answer-letter">@letter</span>
                                        <span>@today.Options[index]</span>
                                        @Icon("circle-check")
                                    </label>
                                }
                            </fieldset>
                        }
                        <span class="answer-selection-error" data-answer-error hidden>@Icon("circle-alert")请先填写答案</span>
                        <button class="affinity-button" type="submit">提交我的答案 @Icon("arrow-right")</button>
                        <span class="answer-reward">@Icon("coins")完成作答可获得 @today.RewardPoints 心意</span>
                        <small>@Icon("lock")提交后不能修改；在 TA 完成前，彼此都看不到答案</small>
                    </form>
                }
                else if (!today.IsRevealed)
                {
                    var myAnswer = today.Type == AffinityQuestionType.OpenEnded
                        ? today.MyAnswer!.Text
                        : string.Join("、", today.MyAnswer!.SelectedOptionIndexes.Select(index => today.Options[index]));
                    <div class="waiting-state">
                        <span class="waiting-hearts">@Icon("heart")@Icon("sparkles")</span>
                        <h3>你的答案已经提交</h3>
                        <p>等待 @Model.PartnerName 回答……双方完成后会在这里一起揭晓。</p>
                        <div class="waiting-answer-meta">
                            <span class="my-hidden-answer">@Icon("lock")你的选择：@myAnswer</span>
                            @if (today.MyAnsweredAt is { } answeredAt)
                            {
                                <span class="my-hidden-answer">@Icon("clock")作答于 @answeredAt.ToString("HH:mm")</span>
                            }
                            <span class="my-hidden-answer">@Icon("coins")已获得 @today.RewardPoints 心意</span>
                        </div>
                    </div>
                }
                else
                {
                    var myAnswer = today.Type == AffinityQuestionType.OpenEnded
                        ? today.MyAnswer!.Text
                        : string.Join("、", today.MyAnswer!.SelectedOptionIndexes.Select(index => today.Options[index]));
                    var partnerAnswer = today.Type == AffinityQuestionType.OpenEnded
                        ? today.PartnerAnswer!.Text
                        : string.Join("、", today.PartnerAnswer!.SelectedOptionIndexes.Select(index => today.Options[index]));
                    <div class="reveal-state">
                        <p class="reveal-title">@(today.IsMatch ? "🎉 今日默契达成" : "答案不同，也是在了解彼此")</p>
                        <div class="reveal-answers">
                            <div>
                                <header>
                                    <span>@Model.MyName</span>
                                    @if (today.MyAnsweredAt is { } myTime)
                                    {
                                        <time datetime="@myTime.ToString("O")">@myTime.ToString("HH:mm")</time>
                                    }
                                </header>
                                <strong>@myAnswer</strong>
                            </div>
                            <span class="reveal-link">@(today.IsMatch ? Icon("heart") : Icon("sparkles"))</span>
                            <div>
                                <header>
                                    <span>@Model.PartnerName</span>
                                    @if (today.PartnerAnsweredAt is { } partnerTime)
                                    {
                                        <time datetime="@partnerTime.ToString("O")">@partnerTime.ToString("HH:mm")</time>
                                    }
                                </header>
                                <strong>@partnerAnswer</strong>
                            </div>
                        </div>
                        <p>@(today.IsMatch ? "你们想到一起去了，默契 +1" : "原来 TA 是这样想的，又多懂彼此一点啦")</p>
                    </div>
                }
            </section>
        }

        <section class="affinity-history" aria-labelledby="history-title">
            <header>
                <div><p>OUR ANSWERS</p><h2 id="history-title">答题足迹</h2></div>
                <span>只展示两个人都完成的题目</span>
            </header>

            @if (Model.Dashboard.History.Items.Count == 0)
            {
                <p class="history-empty">第一份共同答案，会从这里开始被好好收藏。</p>
            }
            else
            {
                <div class="history-list">
                    @foreach (var item in Model.Dashboard.History.Items)
                    {
                        var itemCreatorName = item.CreatorRole is { } itemCreatorRole
                            ? Model.Site.RoleName(itemCreatorRole)
                            : "系统预置";
                        <article class="history-card@(item.IsMatch ? " is-match" : null)">
                            <div class="history-meta">
                                <div class="history-origin">
                                    <time datetime="@item.Day">@item.Day.Replace("-", ".")</time>
                                    <span>@Icon("user-round")@itemCreatorName 出题</span>
                                </div>
                                <div class="history-badges">
                                    @if (item.LoveDay > 0)
                                    {
                                        <span class="history-love-day">@Icon("clock")第 @item.LoveDay 天</span>
                                    }
                                    <span>@item.Category</span>
                                    <b>@(item.IsMatch ? "默契" : "不同答案")</b>
                                </div>
                            </div>

                            <h3>@item.Question</h3>

                            <div class="history-answers">
                                <section class="history-answer">
                                    <header>
                                        <strong>@Model.MyName</strong>
                                        <time datetime="@item.MyAnsweredAt.ToString("O")">@item.MyAnsweredAt.ToString("HH:mm")</time>
                                    </header>
                                    <p>@item.MyAnswer</p>
                                </section>

                                <section class="history-answer">
                                    <header>
                                        <strong>@Model.PartnerName</strong>
                                        <time datetime="@item.PartnerAnsweredAt.ToString("O")">@item.PartnerAnsweredAt.ToString("HH:mm")</time>
                                    </header>
                                    <p>@item.PartnerAnswer</p>
                                </section>
                            </div>
                        </article>
                    }
                </div>

                var pager = new PaginationModel(Model.Dashboard.History.Page, Model.Dashboard.History.TotalPages, "/affinity");
                <partial name="_Pagination" model="pager" />
            }
        </section>
    </div>
</main>
