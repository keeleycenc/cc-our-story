@model CommentsViewModel
@{
    // 没有 JS 时回复就是给表单挂一个 parentId 再跳回来；有 JS 时表单直接搬到那条留言下面
    var isReplying = Model.ReplyTo > 0;
    var canWrite = Model.AllowComment && (Model.IsLoggedIn || Model.AllowGuestComments);
}
<section class="comments" id="comments">
    <header class="comments-heading">
        <p>OUR WORDS</p>
        <h2>@Icon("message-circle-heart")@(Model.TotalCount switch { 0 => "还没有留言", 1 => "1 条留言", var count => $"{count} 条留言" })</h2>
    </header>

    @if (Model.Comments.Count > 0)
    {
        <ol class="comment-list">
            @foreach (var comment in Model.Comments)
            {
                <partial name="_CommentItem" model="@(new CommentItemModel(comment, Model.Slug))" />
            }
        </ol>
    }

    @if (canWrite)
    {
        <div id="respond" class="respond">
            <div class="respond-head">
                <h3 id="response">@Icon("pen-line")<span data-respond-title>@(isReplying ? "回复这条留言" : "写下想说的话")</span></h3>
                <a class="cancel-comment-reply" href="@($"/moments/{Model.Slug}#respond")"@(isReplying ? null : Html.Raw(" hidden"))>@Icon("x")取消回复</a>
            </div>

            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <p class="comment-identity is-error">@Icon("circle-alert")@Model.Error</p>
            }

            <form method="post" asp-page-handler="Comment" id="comment-form" class="comment-form" role="form">
                <input type="hidden" name="replyTo" value="@Model.ReplyTo">

                @if (Model.IsLoggedIn)
                {
                    <p class="comment-identity">@Icon("user-round")正在以 <strong>@Model.DisplayName</strong> 的身份留言 · <a href="/logout">退出</a></p>
                }
                else
                {
                    <div class="comment-fields">
                        <label><span>名字 *</span><input type="text" name="author" placeholder="怎么称呼你" autocomplete="name" maxlength="32" required></label>
                        <label><span>邮箱@(Model.RequireMail ? " *" : "")</span><input type="email" name="mail" placeholder="仅用于识别，不会公开" autocomplete="email" maxlength="120"@(Model.RequireMail ? " required" : "")></label>
                    </div>
                    <label class="comment-url"><span>个人网站</span><input type="url" name="url" placeholder="https://（选填）" autocomplete="url" maxlength="200"></label>
                }

                <label class="comment-text"><span>留言内容 *</span><textarea name="text" rows="5" placeholder="把此刻想说的话留在这里…" maxlength="2000" required></textarea></label>
                <div class="comment-submit-row"><small>@Icon("heart")你们的每一句话，都会被认真收藏。</small><button type="submit">@Icon("send")留下这句话</button></div>
            </form>
        </div>
    }
    else
    {
        <p class="comments-closed">@Icon("lock")这篇记录暂时关闭了留言。</p>
    }
</section>
