@model DateFieldModel
@* 全站统一的日期／时间选择器。原生控件负责取值与移动端交互，
   脚本提供日历按钮及「今天／此刻」快捷操作；脚本不可用时保留浏览器原生能力。 *@
<div class="field date-field">
    <label for="@Model.ElementId">@Model.Label</label>
    <div class="date-control" data-date-field>
        <input id="@Model.ElementId"
               name="@Model.FieldName"
               type="@Model.InputType"
               value="@Model.Value"
               min="@Model.Min"
               max="@Model.Max"
               required="@Model.Required"
               data-date-input>
        <button class="date-control-open" type="button" tabindex="-1" aria-hidden="true" data-date-open hidden>@Icon("calendar-days")</button>
        <button class="date-control-now" type="button" data-date-now hidden>@Model.NowLabel</button>
    </div>
    @if (!string.IsNullOrEmpty(Model.Hint))
    {
        <small>@Model.Hint</small>
    }
</div>
