@page "/anniversaries/{id:int}"
@model OurStory.Web.Pages.Anniversaries.DetailModel
@{
    ViewData["Title"] = Model.Item.Title;
    ViewData["ActiveNav"] = "anniversaries";
    ViewData["Bundle"] = "anniversaries";

    var item = Model.Item;
}
<main id="main" class="anniversary-detail-page kind-@item.Kind.ToString().ToLowerInvariant()">
    <article class="anniversary-story">
        <header class="anniversary-story-header">
            <div class="anniversary-story-tags">
                <span>@Icon(IndexModel.KindIcon(item.Kind))@IndexModel.KindName(item.Kind)</span>
                @if (item.RepeatYearly)
                {
                    <span>@Icon("history")每年重逢</span>
                }
                <span>@Icon("calendar-days")@item.CalendarName</span>
                @if (item.IsPrivate)
                {
                    <span class="is-private">@Icon("lock")仅情侣可见</span>
                }
                <span class="anniversary-author">@Icon("user-round")由 @item.AuthorName 记录</span>
            </div>
            <time datetime="@item.OriginalDate.ToString("yyyy-MM-dd")">公历 @item.OriginalDate.ToString("yyyy 年 MM 月 dd 日")</time>
            @if (item.CalendarType == AnniversaryCalendarType.Lunar)
            {
                <span class="anniversary-story-lunar">@item.LunarDate.DisplayText</span>
            }
            <h1>@item.Title</h1>
            <p>@(item.IsToday ? "就在今天" : item.NextDate is null ? "一次被好好收藏的日子" : $"下一次还有 {item.DaysUntil} 天")</p>
        </header>

        <div class="anniversary-story-layout">
            <div class="anniversary-story-body article-body">
                @if (item.NoteHtml.Length > 0)
                {
                    @Model.Story
                }
                else if (item.Note.Length > 0)
                {
                    <p>@item.Note</p>
                }
                else
                {
                    <p class="anniversary-story-empty">这一天的故事，还等着你们慢慢写下来。</p>
                }
            </div>

            <aside class="anniversary-story-facts">
                <a class="anniversary-facts-back" href="/anniversaries">@Icon("arrow-left")返回纪念日</a>
                <div><span>公历日期</span><strong>@item.OriginalDate.ToString("yyyy.MM.dd")</strong></div>
                @if (item.CalendarType == AnniversaryCalendarType.Lunar)
                {
                    <div><span>原农历日期</span><strong>@item.LunarDate.ShortText</strong></div>
                }
                @if (item.NextDate is not null)
                {
                    <div><span>下一次</span><strong>@item.NextDate.Value.ToString("yyyy.MM.dd")</strong></div>
                }
                <div><span>已经走过</span><strong>@Math.Max(1, Model.Today.DayNumber - item.OriginalDate.DayNumber + 1) 天</strong></div>
                @if (User.IsOwner())
                {
                    <a class="anniversary-edit-link" href="/admin/anniversaries/edit/@item.Id">@Icon("pen-line")编辑这篇纪念日</a>
                }
                <nav class="anniversary-story-nav" aria-label="纪念日文章导航">
                    <div>
                        @if (Model.Previous is not null)
                        {
                            <a href="@Model.Previous.Url" title="@Model.Previous.Title">@Icon("chevron-left")<span>上一个</span></a>
                        }
                        else
                        {
                            <span class="is-disabled">@Icon("chevron-left")<span>上一个</span></span>
                        }
                        @if (Model.Next is not null)
                        {
                            <a href="@Model.Next.Url" title="@Model.Next.Title"><span>下一个</span>@Icon("chevron-right")</a>
                        }
                        else
                        {
                            <span class="is-disabled"><span>下一个</span>@Icon("chevron-right")</span>
                        }
                    </div>
                </nav>
            </aside>
        </div>
    </article>
</main>
